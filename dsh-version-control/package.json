{
  "name": "dsh-version-control",
  "version": "0.4.0",
  "description": "Official ui-sidebar-right Git and SVN version control plugin for DSH",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "sidebarRightTabs",
        "slots",
        "locale"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-client-ui-sidebar-right": ">=0.1.5-rc.1"
  },
  "scripts": {
    "test": "node --test"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "version-control",
    "git",
    "svn",
    "subversion"
  ],
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}
