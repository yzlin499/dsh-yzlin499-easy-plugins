{
  "name": "dsh-mcp-compat",
  "version": "0.14.1",
  "description": "DSH plugin: auto-load MCP servers from standard agent configs (.mcp.json / opencode.json / .cursor/mcp.json / .codex/config.toml), keeping project tools scoped to their workspace",
  "type": "module",
  "main": "index.js",
  "icon": "./icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "slots",
        "contextMenus",
        "sidebarRightTabs"
      ],
      "platform": "web"
    }
  },
  "license": "MIT",
  "scripts": {
    "test": "node --test"
  }
}













